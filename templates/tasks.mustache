{{!
    @template block_deadline_checker/tasks

    The task list, empty state and pagination.

    Rendered by PHP for the first paint and re-rendered by the AMD module whenever the learner
    filters, pages or marks a task complete. The urgency pill is aria-hidden because the row's
    accessible name already carries the same information in words.

    Context variables required for this template:
    * blockid string Unique id for this block instance
    * pageslabel string Accessible name for the pagination nav
    * rows array Task rows. Each carries cantoggle, canedit and hasactions: completion, editing
      and whether there is any action at all, which are three different questions once a learner
      can keep deadlines of their own alongside their courses'.
    * hasrows bool Whether there is anything to list
    * emptytext string Shown when there is not
    * haspages bool Whether pagination is needed
    * pageinfo string For example "1–5 of 9"
    * prevdisabled bool
    * nextdisabled bool
    * prevlabel string Accessible name for the previous button
    * nextlabel string Accessible name for the next button

    Example context (json):
    {
        "blockid": "dlblock-1",
        "pageslabel": "Deadline pages",
        "hasrows": true,
        "emptytext": "Nothing outstanding in this course.",
        "haspages": true,
        "pageinfo": "1–5 of 9",
        "prevdisabled": true,
        "nextdisabled": false,
        "prevlabel": "Previous page, unavailable",
        "nextlabel": "Next page, page 2 of 2",
        "rows": [{
            "id": "t1",
            "name": "Reflective log 3",
            "meta": "Operational leadership · due Wed 5 Aug, 17:00",
            "aria": "Reflective log 3, Operational leadership, overdue by 3 days, was due Wed 5 Aug, 17:00.",
            "stamptext": "Overdue",
            "stampvariant": "overdue",
            "tinted": true,
            "complete": false,
            "expanded": false,
            "cantoggle": true,
            "canedit": false,
            "hasactions": true,
            "haslink": false,
            "url": null,
            "chevronlabel": "Show actions for Reflective log 3: mark as complete",
            "actioncta": "Mark as complete",
            "actionaria": "Mark as complete: Reflective log 3",
            "editcta": "Edit",
            "editaria": "Edit deadline: Reflective log 3",
            "deletecta": "Delete",
            "deletearia": "Delete deadline: Reflective log 3"
        }]
    }
}}
<ul class="block_deadline_checker__list" aria-labelledby="{{blockid}}-title">
    {{#rows}}
        <li class="block_deadline_checker__row{{#tinted}} block_deadline_checker__row--tinted{{/tinted}}"
            data-task="{{id}}">

            <div class="block_deadline_checker__grid">

                {{#hasactions}}
                    <button type="button"
                            class="block_deadline_checker__chevron{{#expanded}} block_deadline_checker__chevron--open{{/expanded}}{{#complete}} block_deadline_checker__chevron--complete{{/complete}}"
                            data-action="toggle"
                            aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"
                            aria-label="{{chevronlabel}}">
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                {{/hasactions}}
                {{^hasactions}}
                    {{! The course decides this activity's completion and its date, so there is
                        nothing to reveal. The column stays to keep the rows aligned. }}
                    <span class="block_deadline_checker__chevron block_deadline_checker__chevron--none"
                          aria-hidden="true"></span>
                {{/hasactions}}

                {{#haslink}}
                    <a class="block_deadline_checker__name" href="{{url}}" aria-label="{{aria}}">
                        {{name}}
                        <span class="block_deadline_checker__meta" aria-hidden="true">{{meta}}</span>
                    </a>
                {{/haslink}}
                {{^haslink}}
                    <span class="block_deadline_checker__name block_deadline_checker__name--static">
                        {{name}}
                        <span class="block_deadline_checker__meta">{{meta}}</span>
                        <span class="visually-hidden">{{aria}}</span>
                    </span>
                {{/haslink}}

                <span class="block_deadline_checker__stamp block_deadline_checker__stamp--{{stampvariant}}"
                      aria-hidden="true">{{stamptext}}</span>

            </div>

            {{#expanded}}
                <div class="block_deadline_checker__actions">
                    {{#cantoggle}}
                        <button type="button"
                                class="block_deadline_checker__action"
                                data-action="confirm"
                                aria-label="{{actionaria}}">
                            <i class="fa-solid fa-check" aria-hidden="true"></i>{{actioncta}}
                        </button>
                    {{/cantoggle}}
                    {{#canedit}}
                        {{! Only on deadlines the learner wrote down themselves. A course's dates
                            are the course's to change, and Moodle already has a place for that. }}
                        <button type="button"
                                class="block_deadline_checker__action block_deadline_checker__action--quiet"
                                data-action="edit"
                                aria-label="{{editaria}}">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>{{editcta}}
                        </button>
                        <button type="button"
                                class="block_deadline_checker__action block_deadline_checker__action--destructive"
                                data-action="delete"
                                aria-label="{{deletearia}}">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>{{deletecta}}
                        </button>
                    {{/canedit}}
                </div>
            {{/expanded}}

        </li>
    {{/rows}}
</ul>

{{^hasrows}}
    <div class="block_deadline_checker__empty">
        <i class="fa-regular fa-circle-check block_deadline_checker__emptyicon" aria-hidden="true"></i>
        <p class="block_deadline_checker__emptytext">{{emptytext}}</p>
    </div>
{{/hasrows}}

{{#haspages}}
    <nav class="block_deadline_checker__pager" aria-label="{{pageslabel}}">
        <button type="button"
                class="block_deadline_checker__pagebtn"
                data-action="prev"
                aria-label="{{prevlabel}}"
                {{#prevdisabled}}disabled{{/prevdisabled}}>
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <span class="block_deadline_checker__pageinfo">{{pageinfo}}</span>
        <button type="button"
                class="block_deadline_checker__pagebtn"
                data-action="next"
                aria-label="{{nextlabel}}"
                {{#nextdisabled}}disabled{{/nextdisabled}}>
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
    </nav>
{{/haspages}}
